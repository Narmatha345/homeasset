# Server
PORT=4000
NODE_ENV=development

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Database
# By default (USE_MEMORY_DB=true) the backend starts an in-process, in-memory
# MongoDB instance via mongodb-memory-server - no local Mongo install needed.
# Data persists only while the backend process is running (a browser refresh
# is fine; restarting the backend resets and reseeds the demo data).
#
# To use a real MongoDB instead (e.g. MongoDB Atlas or a local/Docker Mongo),
# set USE_MEMORY_DB=false and provide MONGODB_URI.
USE_MEMORY_DB=true
MONGODB_URI=mongodb://127.0.0.1:27017/homeasset

# Demo account (used by the seed script)
DEMO_EMAIL=demo@homeasset.com
DEMO_PASSWORD=Demo@123
